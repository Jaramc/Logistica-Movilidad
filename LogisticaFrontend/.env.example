# Déjelo VACÍO: el frontend llama a /api en el mismo origen.
# En desarrollo el proxy de Vite reenvía /api al backend; en producción lo hace Caddy.
# Solo cámbielo si sabe lo que hace: con otro origen, las cookies SameSite=Strict y __Host- no funcionan.
VITE_API_URL=

# Backend al que el proxy de Vite reenvía /api en desarrollo (perfil "https" de launchSettings).
VITE_PROXY_TARGET=https://localhost:7216

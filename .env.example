# Copia este archivo a .env (ignorado por git) y reemplaza los valores.
# NUNCA subas el archivo .env al repositorio.
POSTGRES_DB=logistica_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password
# Puerto local (solo 127.0.0.1). Cámbielo si 5432 ya lo usa otro PostgreSQL.
POSTGRES_PORT=5432
